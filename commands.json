{
  "$schema": "https://cdn.subsquid.io/schemas/commands.json",
  "commands": {
    "clean": {
      "description": "delete all build artifacts",
      "cmd": ["npx", "--yes", "rimraf", "lib"]
    },
    "build": {
      "description": "Build the squid project",
      "deps": ["clean"],
      "cmd": ["sh", "-c", "tsc && tsc-alias"]
    },
    "up": {
      "description": "Start a PG database",
      "cmd": ["docker", "compose", "up", "-d"]
    },
    "down": {
      "description": "Drop a PG database",
      "cmd": ["docker", "compose", "down"]
    },
    "migration:apply": {
      "description": "Apply the DB migrations",
      "cmd": ["squid-typeorm-migration", "apply"]
    },
    "migration:generate": {
      "description": "Generate a DB migration matching the TypeORM entities",
      "cmd": ["squid-typeorm-migration", "generate"]
    },
    "migration:clean": {
      "description": "Clean the DB migrations",
      "cmd": ["npx", "--yes", "rimraf", "./db/migrations"]
    },
    "typegen:polkadot": {
      "description": "Generate Polkadot runtime type definitions",
      "cmd": ["npx", "@subsquid/substrate-typegen", "typegen/typegen.polkadot.json"]
    },
    "typegen:assethub": {
      "description": "Generate AssetHub runtime type definitions",
      "cmd": ["npx", "@subsquid/substrate-typegen", "typegen/typegen.assethub.json"]
    },
    "typegen": {
      "description": "Generate type definitions for both Polkadot and AssetHub",
      "cmd": ["npm", "run", "typegen"]
    },
    "codegen": {
      "description": "Generate the code for the model",
      "cmd": ["npx", "squid-typeorm-codegen"]
    },
    "process:polkadot": {
      "description": "Load .env and start the Polkadot processor",
      "deps": ["build", "migration:apply"],
      "cmd": ["node", "lib/main.js", "polkadot"]
    },
    "process:assethub": {
      "description": "Load .env and start the AssetHub-Polkadot processor",
      "deps": ["build", "migration:apply"],
      "cmd": ["node", "lib/main.js", "assethub-polkadot"]
    },
    "process:prod:polkadot": {
      "description": "Start the Polkadot processor for production",
      "cmd": ["node", "lib/main.js", "polkadot"]
    },
    "process:prod:assethub": {
      "description": "Start the AssetHub-Polkadot processor for production",
      "cmd": ["node", "lib/main.js", "assethub-polkadot"]
    },
    "serve": {
      "description": "Start the GraphQL API server",
      "cmd": ["squid-graphql-server"]
    }
  }
}


